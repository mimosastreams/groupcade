{
  "name": "groupcade",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.23",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.56",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --latest",

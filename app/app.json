{
  "expo": {
    "name": "Groupcade",
    "slug": "groupcade",
    "owner": "seensorts-team",
    "scheme": "groupcade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.groupcade.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Groupcade looks for a Chromecast or Google TV on your Wi-Fi so you can put the game on the TV."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#15122B"
        }
      ],
      "./modules/groupcade-tv/app.plugin.js"
    ],
    "extra": {
      "apiBase": "https://groupcade.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.groupcade.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#15122B"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}
